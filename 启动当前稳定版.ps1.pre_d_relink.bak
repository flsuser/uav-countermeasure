$ErrorActionPreference = "Stop"
$here = Split-Path -Parent $MyInvocation.MyCommand.Path
$localPython = Join-Path $here ".venv\Scripts\python.exe"
$projectPython = "C:\Users\23102\Documents\无人机反制\uav_detection\.venv\Scripts\python.exe"

if (Test-Path -LiteralPath $localPython) {
    $python = $localPython
} elseif (Test-Path -LiteralPath $projectPython) {
    $python = $projectPython
} else {
    throw "未找到项目 Python 环境。请在本目录创建 .venv 并安装 ultralytics、torch、numpy 和 opencv-contrib-python。"
}

Set-Location -LiteralPath $here
$arguments = @(
    ".\run_tracking_only.py",
    "--weights", ".\runs\rfly_uav_yolo11n_mountain\weights\best.pt",
    "--gimbal", "--scenario", "easy",
    "--config", ".\Config_gimbal.json",
    "--imgsz", "960",
    "--conf", "0.18",
    "--acquire-conf", "0.30",
    "--deadband", "0.03",
    "--gimbal-yaw-kp", "82",
    "--gimbal-pitch-kp", "52",
    "--max-gimbal-yaw-rate", "45",
    "--max-gimbal-pitch-rate", "30",
    "--log-csv", ".\runs\gimbal_saved_version.csv"
)
& $python $arguments

